PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=development-secret
OTP_EXPIRY_MINUTES=10
DEV_EXPOSE_OTP=true

# Firebase Firestore Configuration (Vercel & Local)
# You can provide individual credentials:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...YOUR_KEY...\n-----END PRIVATE KEY-----\n"

# OR full service account JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Frontend API URL (leave empty for automatic detection)
VITE_API_BASE_URL=
