{
  "version": 2,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://pharmacy-production-e7bf.up.railway.app/api/$1"
    },
    {
      "source": "/((?!assets/|favicon.svg|icons.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}



